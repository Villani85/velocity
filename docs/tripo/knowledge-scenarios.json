    ],
    "en": [
     "bare geometry: no texture credits spent",
     "flatten_bottom helps FDM adhesion",
     "for color prints use --then convert:3mf,export_vertex_colors=true"
    ]
   }
  },
  {
   "id": "ar-web",
   "label": {
    "zh": "AR/Web/电商",
    "en": "AR / Web / e-commerce"
   },
   "description": {
