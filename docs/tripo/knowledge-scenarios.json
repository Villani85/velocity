    ],
    "en": [
     "generate with v3.1, then decimate under 20k faces",
     "iOS QuickLook requires USDZ",
     "decimate bakes textures onto the low-poly by default"
    ]
   }
  },
  {
   "id": "anim",
   "label": {
    "zh": "角色动画",
    "en": "Character animation"
   },
   "description": {
    "zh": "绑骨+动作重定向全链路",
    "en": "Full rig + retarget pipeline"
   },
   "model": "v3.1-20260211",
   "genParams": {
    "texture": true,
    "pbr": true
   },
   "chain": [
    {
     "step": "rig-check",
     "args": {}
    },
    {
     "step": "rig",
     "args": {
      "model": "v2.5-20260210",
      "spec": "tripo",
      "out_format": "glb"
     }
    },
    {
     "step": "retarget",
     "args": {
      "animations": [
       "preset:idle",
       "preset:walk"
      ]
     }
    }
   ],
   "deliverables": [
    "GLB",
    "FBX"
   ],
   "notes": {
    "zh": [
     "先 rig-check 预检,不可绑骨即止损",
     "接 Mixamo/Unity Humanoid 用 rig:spec=mixamo",
     "提示词建议 T-pose 站姿,或先 text-to-image template=t_pose"
    ],
    "en": [
     "rig-check first: stop early if not riggable",
     "use rig:spec=mixamo for Mixamo/Unity Humanoid",
     "prompt for a T-pose, or pre-generate with text-to-image template=t_pose"
    ]
   }
  },
